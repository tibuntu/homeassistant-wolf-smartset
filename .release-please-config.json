{
  "packages": {
    ".": {
      "release-type": "python",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "refactor",
          "section": "Other",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Other",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Other",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Other",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "custom_components/wolf_smartset/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='homeassistant-wolf-smartset')].version"
        }
      ],
      "bump-minor-pre-major": true
    }
  },
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}
