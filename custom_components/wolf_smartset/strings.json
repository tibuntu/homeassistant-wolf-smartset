{
  "config": {
    "step": {
      "user": {
        "title": "Wolf SmartSet account",
        "description": "Uses the same unofficial cloud interface as the SmartSet portal. Disable the core Wolf SmartSet Service integration for this account to avoid duplicate logins.",
        "data": {
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "username": "The username of your Wolf SmartSet account.",
          "password": "The password of your Wolf SmartSet account (at most 30 characters)."
        }
      },
      "systems": {
        "title": "Select systems",
        "data": {
          "systems": "Systems"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Wolf SmartSet",
        "description": "Wolf SmartSet rejected the password of {username}.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid username or password.",
      "cannot_connect": "Failed to connect to Wolf SmartSet.",
      "portal_unavailable": "The Wolf SmartSet portal is unavailable or temporarily blocks this IP address. Try again in an hour.",
      "password_too_long": "Wolf SmartSet accepts at most 30 characters.",
      "no_system_selected": "Select at least one system.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "no_systems": "The account has no Wolf systems.",
      "reauth_successful": "Re-authentication was successful."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Poll interval",
          "dry_run": "Dry run (do not write)",
          "max_writes_per_hour": "Maximum writes per hour"
        },
        "data_description": {
          "scan_interval": "Seconds between polls. Wolf allows at most one poll per minute.",
          "dry_run": "While on, changes are only logged (INFO) with parameter, old and new value; nothing is sent to the heating system.",
          "max_writes_per_hour": "Protects the controller's EEPROM against automation loops. Writes that are skipped because the value is already set do not count. Failed writes count."
        }
      }
    }
  },
  "exceptions": {
    "not_writable": {
      "message": "{name} cannot be written."
    },
    "access_denied": {
      "message": "The Wolf SmartSet account has no write access for {name}."
    },
    "invalid_option": {
      "message": "{value} is not a valid option for {name}."
    },
    "out_of_range": {
      "message": "{value} is outside the range of {name} ({min} to {max})."
    },
    "invalid_number": {
      "message": "{value} is not a number for {name}."
    },
    "invalid_step": {
      "message": "{value} does not match the step {step} of {name}."
    },
    "rate_limited": {
      "message": "Write limit of {limit} per hour reached. Change the limit in the integration options."
    },
    "write_failed": {
      "message": "Writing {name} failed: {error}"
    },
    "nothing_to_undo": {
      "message": "There is no applied change to undo."
    }
  },
  "issues": {
    "throttled": {
      "title": "Wolf SmartSet throttles {system} or blocks the login",
      "description": "Wolf SmartSet answered several polls with throttling or empty responses, or the login is blocked after repeated failures. The integration polls less often until the portal answers again. Check that no other client logs in with this account from your network."
    },
    "wolflink_active": {
      "title": "Core Wolf SmartSet Service integration is active",
      "description": "The core Wolf SmartSet Service integration is loaded as well. Both log in from the same IP address, which can make Wolf block the address for up to an hour, including the SmartSet app. Disable the core integration if it uses the same account."
    }
  },
